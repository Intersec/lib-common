package iopsq;

/** An IOP name: a package element, a field... IOP forbids underscores. */
@pattern("[a-zA-Z0-9]*") @minLength(1)
typedef string Identifier;

/** A generic attribute namespace or id, where underscores are allowed. */
@pattern("[a-zA-Z0-9_]*") @minLength(1)
typedef string AttrName;

/** An IOP name with an optional package path: `pkg.Element` or `Element`. */
@pattern("[a-zA-Z0-9\.]*") @minLength(1)
typedef string FullName;

/* {{{ Type */

@ctype(iop__int_size__t)
enum IntSize {
    S8,
    S16,
    S32,
    S64,
};

@ctype(iop__int_type__t)
struct IntType {
    bool isSigned;
    IntSize size;
};

@ctype(iop__string_type__t)
enum StringType {
    STRING,
    BYTES,
    XML,
};

@ctype(iop__type__t)
union Type {
    IntType i;
    void b;
    void d;
    StringType s;
    void v;

    FullName typeName;

    /* TODO Could include length contraints. */
    Type& array;

    /** Type identifier generated by a type table.
     *
     * This kind of field can be used when generating local IOPs from other
     * generated IOPs.
     *
     * See \p iopsq_type_table_fill_type documentation for more information.
     */
    uint typeId;
};

/* }}} */

@ctype(iop__package_elem__t)
abstract local class PackageElem {
    Identifier name;
};

/* {{{ Struct */

@ctype(iop__value__t)
union Value {
    long i;
    ulong u;
    double d;
    string s;
    bool b;
};

@ctype(iop__opt_info__t)
struct OptInfo {
    Value? defVal;
};

/** A field constraint, mirroring the built-in IOP `@`-attributes.
 *
 * The active union case selects the constraint kind; its value (when any)
 * follows the semantics of the corresponding IOP attribute. */
@ctype(iop__constraint__t)
union Constraint {
    Value min;
    Value max;
    ulong minOccurs;
    ulong maxOccurs;
    ulong minLength;
    ulong maxLength;
    ulong length;
    string pattern;
    void nonEmpty;
    void nonZero;
    void cdata;
    void isPrivate;
    void isDeprecated;
};

/** A user-defined generic attribute: `@(namespace:id, value)`. */
@ctype(iop__generic_attr__t)
struct GenericAttr {
    AttrName ns;
    AttrName id;
    Value value;
};

@ctype(iop__field__t)
struct Field {
    Identifier name;
    Type type;
    OptInfo? optional;
    ushort? tag;
    void? isReference;
    Constraint[] constraints;
    GenericAttr[] genericAttrs;
};

@ctype(iop__structure__t)
abstract local class Structure : 1 : PackageElem {
    GenericAttr[] genericAttrs;
};

@ctype(iop__struct__t)
local class Struct : 2 : Structure {
    Field[] fields;
};

/* }}} */
/* {{{ Enum */

@ctype(iop__enum_val__t)
struct EnumVal {
    @pattern("[A-Z0-9_]*") @minLength(1)
    string name;
    int? val;
    /** Alternative names accepted when unpacking this value. */
    @pattern("[A-Z0-9_]*") @minLength(1)
    string[] aliases;
};

@ctype(iop__enum__t)
local class Enum : 3 : PackageElem {
    EnumVal[] values;
    /** Reject unknown integer values when (un)packing. */
    bool strict = false;
};

/* }}} */
/* {{{ Union */

@ctype(iop__union__t)
local class Union : 4 : Structure {
    @minOccurs(1)
    Field[] fields;
};

/* }}} */
/* {{{ Typedef */

@ctype(iop__typedef__t)
local class Typedef : 5 : PackageElem {
    Type type;
};

/* }}} */
/* {{{ Class */

/** A class static field: `static <type> <name> = <value>;`. */
@ctype(iop__static_field__t)
struct StaticField {
    Identifier name;
    Type type;
    Value value;
};

@ctype(iop__class__t)
local class Class : 6 : Structure {
    Field[] fields;
    /** Full name of the parent class; absent for a master class.
     *
     * The parent must be another class declared in the same package, listed
     * before this one. */
    FullName? parent;
    ushort classId = 0;
    bool isAbstract = false;
    bool isPrivate = false;
    StaticField[] staticFields;
};

/* }}} */
/* {{{ Interface */

/** Arguments, result or exceptions of an RPC: an anonymous inline structure.
 *
 * When the corresponding RPC field is absent, the part is `void`. */
@ctype(iop__rpc_struct__t)
struct RPCStruct {
    Field[] fields;
};

/** A remote procedure of an interface.
 *
 * Only the interface part is described (no handler binding). Each of \p arg,
 * \p res and \p exn defines an anonymous structure; an absent part is `void`.
 */
@ctype(iop__rpc__t)
struct RPC {
    Identifier name;
    ushort? tag;
    RPCStruct? arg;
    RPCStruct? res;
    RPCStruct? exn;
    /** Asynchronous RPC (`out null`): never returns a result and cannot throw.
     */
    bool isAsync = false;
};

@ctype(iop__iface__t)
local class Iface : 7 : PackageElem {
    RPC[] rpcs;
};

/* }}} */
/* {{{ Module */

/** Reference to an interface inside a module, bound under an alias name. */
@ctype(iop__module_iface__t)
struct ModuleIface {
    Identifier name;
    /** Name of the referenced interface; must be declared in the same
     * package. */
    FullName iface;
    ushort? tag;
};

@ctype(iop__module__t)
local class Module : 8 : PackageElem {
    ModuleIface[] ifaces;
};

/* }}} */
/* {{{ Package */

@ctype(iop__package__t)
struct Package {
    @pattern("[a-z_\.]*") @minLength(1)
    string name;
    PackageElem[] elems;
    /* TODO sub-packages */
};

/* }}} */
