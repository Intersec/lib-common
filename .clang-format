# Clang-format configuration for lib-common.
#
# Use `// clang-format off` / `// clang-format on` around blocks where
# clang-format produces incorrect output (e.g. column-aligned struct
# initialisers).

BasedOnStyle: LLVM

# --- Basics ---
IndentWidth:          4
UseTab:               Never
TabWidth:             4
ColumnLimit:          78

# --- Braces ---
# Custom brace style based on Linux, with one key difference:
# AfterControlStatement: MultiLine puts `{` on a new line when the condition
# spans multiple lines, matching the coding rule exactly.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass:             true   # C++ (useful for submodule consumers)
  AfterFunction:          true   # fn() \n {
  AfterControlStatement:  MultiLine  # single-line: if (x) {  multi-line: )\n{
  AfterEnum:              false  # enum foo {
  AfterNamespace:         true   # C++ (useful for submodule consumers)
  AfterStruct:            false  # struct foo {
  AfterUnion:             false  # union foo {
  BeforeCatch:            false  # C++ (useful for submodule consumers)
  BeforeElse:             false  # } else {
  IndentBraces:           false

# Prevent short functions from being collapsed to one line.
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# Always wrap single-statement control bodies in braces, as required by the
# coding rules ("Always use braces, even for single-statement blocks").
InsertBraces: true

# --- Control-flow macros ---
# Treat these "block-opening" macros like conditionals so their opening brace
# stays on the same line (MACRO(name) {) and the body is indented as a block,
# instead of being mis-parsed as a function definition.
IfMacros:
  - Z_TEST
  - MODULE_DEFINE
  - OBJ_VTABLE
  - OBJ_EXT_VTABLE
  - OBJ_EXT_VTABLE_WITH_PRIO
  - SO_OBJ_VTABLE
  - SO_OBJ_EXT_VTABLE
  - SO_OBJ_EXT_VTABLE_WITH_PRIO

# --- Spacing ---
# One space after if/while/switch/for, no space before fn() or foreach macros.
SpaceBeforeParens: ControlStatementsExceptForEachMacros

# --- Pointers ---
# Star sticks to the variable name: const char *p, not const char* p.
PointerAlignment: Right
# Don't infer alignment from existing code — always use the setting above.
DerivePointerAlignment: false
# C++ access modifier offset (useful for submodule consumers).
AccessModifierOffset: -2

# --- Function calls and declarations ---
# When a call or declaration wraps, break right after the opening parenthesis,
# block-indent the arguments, and put the closing parenthesis on its own line.
# This keeps multi-line function declarations/calls consistent instead of the
# mix produced by argument alignment.
AlignAfterOpenBracket: BlockIndent
BinPackArguments:     true
BinPackParameters:    true
# Don't put all parameters on the next line as a block when they don't fit.
AllowAllParametersOfDeclarationOnNextLine: false

# --- Braced initializer lists ---
# Block-indent multi-line braced initializers instead of aligning their
# elements to the opening brace (which produces deep, unreadable indentation
# for arrays of structs). Also put the closing brace on its own line.
BreakAfterOpenBracketBracedList: true
BreakBeforeCloseBracketBracedList: true

# --- Ternary operator ---
# Align ':' with '?':
#   a = long_cond ? value1
#                 : value2;
AlignOperands:              Align
BreakBeforeTernaryOperators: true

# --- Preprocessor ---
# CRITICAL: never reorder includes — order is semantically significant.
SortIncludes: false

# Indent cascaded #ifdef/#else/#endif using AfterHash style (2 spaces/level,
# see PPIndentWidth below):
#   #ifdef FOO
#   #  define BAR
#   #  ifdef BAZ
#   #    define QUX
IndentPPDirectives: AfterHash
# Indent nested PP directives by 2 spaces per level (not IndentWidth), matching
# the historical convention (level 1: "#  define", level 2: "#    define").
PPIndentWidth: 2

# --- Apple Blocks (.blk files) ---
# .blk files use Apple's blocks extension; keep block indent consistent.
ObjCBlockIndentWidth: 4

# --- Type macros ---
# Teach clang-format that these macros expand to types, so `*` after them
# is treated as a pointer declarator (PointerAlignment: Right) rather than
# a binary operator (which would produce `qv_t(foo) * p` with spaces).
TypenameMacros:
  - qv_t
  - qvector_t
  - qm_t
  - qh_t
  - qhh_t
  - qhm_t
  - qhp_t
  - rb_t
  - rb_tree_t
  - spsc_t
  - spsc_queue_t

# --- Foreach-style macros ---
# Teach clang-format that these expand to loops so it treats the following
# braced block correctly (same as a for/while body, not a function call).
ForEachMacros:
  - carray_for_each_entry
  - carray_for_each_pos
  - carray_for_each_ptr
  - dlist_for_each
  - dlist_for_each_continue
  - dlist_for_each_entry
  - dlist_for_each_entry_after
  - dlist_for_each_entry_continue
  - dlist_for_each_entry_start
  - dlist_for_each_rev
  - dlist_for_each_rev_continue
  - dlist_for_each_rev_start
  - dlist_for_each_start
  - file_bin_for_each_entry
  - for_each_thread
  - htlist_for_each
  - htlist_for_each_entry
  - htlist_for_each_entry_start
  - htlist_for_each_start
  - iop_array_for_each
  - iop_array_for_each_const
  - iop_class_for_each_field
  - iop_dso_for_each_ressource
  - iop_dso_ressources_for_each_entry
  - iop_obj_for_each_field
  - iop_struct_for_each_field
  - iop_tab_for_each
  - iop_tab_for_each_const
  - IOP_UNION_SWITCH
  - qhat_for_each
  - qhat_for_each_limit_safe
  - qhat_for_each_limit_unsafe
  - qhat_for_each_safe
  - qhat_for_each_unsafe
  - qh_for_each_key
  - qh_for_each_key_p
  - qh_for_each_pos
  - qhh_for_each_pos
  - qhhash_for_each_pos
  - qhm_for_each_pos
  - qhp_for_each_pos
  - qm_for_each_key
  - qm_for_each_key_p
  - qm_for_each_key_p_value
  - qm_for_each_key_p_value_p
  - qm_for_each_key_value
  - qm_for_each_key_value_p
  - qm_for_each_pos
  - qm_for_each_value
  - qm_for_each_value_p
  - qps_bitmap_for_each_safe
  - qps_bitmap_for_each_unsafe
  - rb_for_each
  - rb_for_each_safe
  - ring_for_each_entry
  - ring_for_each_ptr
  - sockunion_for_each
  - tab_enumerate
  - tab_enumerate_ptr
  - tab_for_each_entry
  - tab_for_each_pos
  - tab_for_each_pos_rev
  - tab_for_each_pos_safe
  - tab_for_each_ptr
  - wah_for_each_
  - xmlr_for_each_attr
