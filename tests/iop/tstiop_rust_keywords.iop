package tstiop_rust_keywords;

/* Names that are keywords in Rust but not in IOP: their Rust names get a
 * `__var` suffix. A field named like a primitive type gets it too, but a
 * union variant does not. */

struct Keywords {
    int match;
    int type;
    int u8;
};

union KeywordUnion {
    int ref;
    int u8;
};
