package tstiop_backward_compat_class_move;

/* `new` version of the twin package in ../old/.
 *
 * `movedDefval` (default value) and `movedOpt` (optional) have been moved up
 * from the child class into the parent class. This is backward compatible for
 * the text encodings (JSON/YAML) but not for the binary encoding. */

class FieldMoveParent : 1 {
    int  parentField;
    int  movedDefval = 0;
    int? movedOpt;
};

class FieldMoveChild : 2 : FieldMoveParent {
    int childField;
};
