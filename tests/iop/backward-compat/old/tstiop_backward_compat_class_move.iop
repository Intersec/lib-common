package tstiop_backward_compat_class_move;

/* This package has a twin in ../new/ used to check the backward compatibility
 * of moving a field between a class and one of its ancestors.
 *
 * Here `movedDefval` (default value) and `movedOpt` (optional) are declared in
 * the child class; in the `new` version they are moved up into the parent
 * class. Such a move is backward compatible for the text encodings (JSON/YAML)
 * but not for the binary encoding. */

class FieldMoveParent : 1 {
    int parentField;
};

class FieldMoveChild : 2 : FieldMoveParent {
    int  childField;
    int  movedDefval = 0;
    int? movedOpt;
};
