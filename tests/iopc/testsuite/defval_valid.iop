package defval_valid;

@min(0) @max(1)
typedef double Mydouble;

struct Test {
    Mydouble d1 = 0.5;
    @min(0) @max(1)
    double d2 = 0.5;
    int c1 = c"a";
    int c2 = c"\"";
    int c3 = c"\n";
    /* A negative integer literal as default of a double field: the sign
     * must be preserved through the integer-to-double conversion. */
    @min(-768) @max(0)
    double dNegInt = -512;
};
