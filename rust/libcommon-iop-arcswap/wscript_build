from waflib.Build import BuildContext

ctx: BuildContext


# This tiny crate provides only the lock-free ArcSwap primitives backing
# `iop_env_t->ctx_swap`. It has no compile-time dependency on any C code,
# so `libcommon-minimal` can `use` it without creating a cycle.
with ctx.UseGroup(ctx, 'libcommon-minimal'):
    ctx(
        target='libcommon-iop-arcswap-rs',
        features='rust',
        cargo_package='libcommon-iop-arcswap',
    )
